# AI Guard Gateway Environment Configuration
PORT=8080

# Target Cloud LLM Provider: 'groq', 'openai', 'gemini', or custom 'ollama'
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_actual_groq_api_key_here

# Security & Optimization Toggles
ENABLE_PROMPT_SANITIZER=true
ENABLE_SMART_TRUNCATE=true
MAX_TOOL_ARRAY_ITEMS=5

# Custom Header Name for Scope/Tenant Context Injection
SCOPE_HEADER_NAME=X-Guard-Scope
